# Copie para ".env" e preencha. O arquivo .env nunca vai para o GitHub.
# Sem chave, a demo roda no modo SIMULADO (busca por palavras-chave, sem IA).
# Gere uma chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MAX_CONCORRENCIA=8
TENTATIVAS=3
MIN_CARACTERES_TEXTO=300

# Opcional: preço por 1 milhão de tokens (USD) para estimar o custo no relatório.
# Confira os valores atuais na página de preços do Gemini.
PRECO_ENTRADA_USD_1M=0
PRECO_SAIDA_USD_1M=0
